{
  "name": "slack-agent-connector",
  "version": "0.2.0",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/awpsec/slack-agent-connector.git" },
  "homepage": "https://github.com/awpsec/slack-agent-connector#readme",
  "bugs": { "url": "https://github.com/awpsec/slack-agent-connector/issues" },
  "keywords": ["slack", "agent", "mcp", "pi-package", "omp-plugin", "claude-code", "codex"],
  "description": "A standalone Slack event connector for any agent harness",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "bin": { "slack-agent": "bin/slack-agent.mjs" },
  "pi": { "extensions": ["./extensions/pi.js"] },
  "omp": { "extensions": ["./extensions/omp.js"] },
  "files": ["bin/", "src/", "extensions/", "public/", "docs/", "INSTALL.md", "README.md", "CHANGELOG.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "peerDependencies": { "@sinclair/typebox": "*" },
  "peerDependenciesMeta": { "@sinclair/typebox": { "optional": true } },
  "scripts": {
    "start": "node bin/slack-agent.mjs serve",
    "setup": "node bin/slack-agent.mjs install",
    "mcp": "node bin/slack-agent.mjs mcp",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.0.0" },
  "devDependencies": { "@sinclair/typebox": "^0.34.41" }
}
